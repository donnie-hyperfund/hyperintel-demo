# Copy to .env.test and fill in values.
# Used by integration tests that hit real APIs.

# AI providers (for inference integration tests)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Database (for integration tests that need persistence)
DATABASE_URL=

# Clerk (for e2e tests — dev instance only)
CLERK_SECRET_KEY=

# Playwright auth bypass (NEVER set in .env, .env.dev, or .env.prd)
E2E_AUTH_BYPASS=true

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST="https://us.cloud.langfuse.com"
LANGFUSE_ENVIRONMENT=development

# Local
LOCAL_PROMPT_LOCATION=true
TEST_PRESET=qwen-local
TEST_VERBOSE=true
# Supports {prompts}, {provider}, {preset} interpolation, e.g. {prompts}-{provider}-{preset}
TEST_CACHE_KEY={prompts}-{provider}
#TEST_CACHE_KEY={prompts}-{provider}-{preset}

TEST_LLM=true