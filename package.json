{
    "name": "my-v0-project",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "build": "next build",
        "vercel-build": "node scripts/prebuild-vercel.js && next build --webpack",
        "dev": "next dev --turbopack",
        "local:prd": "cross-env NODE_ENV=development NODE_OPTIONS=\"--enable-source-maps --inspect\" env-cmd -f .env.prd pnpm dev",
        "local:dev": "cross-env NODE_ENV=development NODE_OPTIONS=\"--enable-source-maps --inspect\" env-cmd -f .env.dev pnpm dev",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "lfix": "biome check --write .",
        "start": "next start",
        "tsn": "tsx",
        "env:dev": "env-cmd -f .env.dev pnpm run ",
        "env:prd": "env-cmd -f .env.prd pnpm run ",
        "db:migration:create": "mikro-orm migration:create --config=mikro-orm.cli.config.ts",
        "db:migration:up": "mikro-orm migration:up --config=mikro-orm.cli.config.ts",
        "db:compile-metadata": "mikro-orm cache:generate --combined --config=mikro-orm.cli.config.ts",
        "tsc:check": "tsc --noEmit",
        "db:compile-jit": "pnpm run tsn common/orm/compile-orm.ts",
        "db:compile": "pnpm run db:compile-metadata && pnpm run db:compile-jit",
        "db:gen-entity": "npx mikro-orm generate-entities --save --path=lib/orm/entities/gen/ --schema=public -- ",
        "gen:workers": "npx tsx workers/_common/config/generate.ts",
        "test": "vitest --project app-unit --project app-e2e --project common --project workers-* --project workers_common",
        "test:unit": "vitest --project app-unit --project common --project workers-* --project workers_common",
        "test:integration": "vitest --project app-integration --project common-integration",
        "test:e2e": "vitest --project app-e2e",
        "test:app": "vitest --project app-unit --project app-e2e",
        "test:app:unit": "vitest --project app-unit",
        "test:app:providers": "vitest --project app-unit --run modules/chat/providers modules/artifacts/providers modules/intake/providers modules/file-uploads/providers \"app/(onboarding)/projects/new/_providers\" components/swr-provider.test.tsx components/theme-provider.test.tsx",
        "test:app:e2e": "vitest --project app-e2e",
        "test:app:integration": "vitest --project app-integration",
        "test:common": "vitest --project common --project common-integration",
        "test:common:unit": "vitest --project common",
        "test:common:integration": "vitest --project common-integration",
        "test:workers": "vitest --project workers-* --project workers_common",
        "test:workers:common": "vitest --project workers_common",
        "test:scenario": "tsx scripts/test-scenario.ts",
        "pw": "playwright test",
        "pw:ui": "playwright test --ui",
        "pw:codegen": "playwright codegen"
    },
