{
    "name": "my-v0-project",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "build": "next build",
        "dev": "next dev",
        "local:prd": "cross-env NODE_ENV=development NODE_OPTIONS=\"--enable-source-maps --inspect\" env-cmd -f .env.prd yarn dev",
        "local:dev": "cross-env NODE_ENV=development NODE_OPTIONS=\"--enable-source-maps --inspect\" env-cmd -f .env.dev yarn dev",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "lfix": "biome check --write .",
        "start": "next start",
        "tsn": "tsx",
        "env:dev": "env-cmd -f .env.dev npm run ",
        "env:prd": "env-cmd -f .env.prd npm run ",
        "db:migration:create": "mikro-orm migration:create --config=mikro-orm.cli.config.ts",
        "db:migration:up": "mikro-orm migration:up --config=mikro-orm.cli.config.ts",
        "db:compile-metadata": "mikro-orm cache:generate --combined --config=mikro-orm.cli.config.ts",
        "db:compile-jit": "npm run tsn common/orm/compile-orm.ts",
        "db:compile": "npm run db:compile-metadata && npm run db:compile-jit",
        "db:gen-entity": "npx mikro-orm generate-entities --save --path=lib/orm/entities/gen/ --schema=public -- "
    },
