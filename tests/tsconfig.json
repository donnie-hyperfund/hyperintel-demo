{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "noImplicitAny": false,
        "types": ["vitest/globals", "@cloudflare/workers-types/2023-07-01"]
    },
    "include": [
        "../cf-types-fallback.d.ts",
        "../worker-env-types.d.ts",
        "./**/*.ts",
        "../**/*.test.ts",
        "../**/*.test.tsx"
    ],
    "exclude": [
        "../node_modules",
        "../.next",
        "../tools",
        "../workers",
        "../.claude/worktrees",
        "../.claude/worktrees/**",
        "../.codex/worktrees",
        "../.codex/worktrees/**",
        "../.codex/**/worktrees",
        "../.codex/**/worktrees/**"
    ]
}
